# Copy to .env and fill in what you have. Every USE_LIVE_* flag defaults to
# false — the pipeline runs entirely on synthetic/mock data with none of
# this set. See README.md and WRITEUP.md for what's real vs synthetic.

# IMD nowcast feed (station lightning/hail/thunderstorm categories).
USE_LIVE_IMD=false
IMD_API_KEY=

# Tomorrow.io realtime weather API — used as a live stand-in for IMD's
# station feed when USE_LIVE_IMD=true (real temp/humidity/wind/precip,
# but no lightning field — see nowcast/ingestion/imd_nowcast.py).
TOMORROW_API_KEY=

# ECMWF Open Data (temperature/humidity/wind grid). Genuinely free, NO API
# KEY NEEDED — just set this to true. See nowcast/ingestion/ecmwf_weather.py
# for why the classic api.ecmwf.int key-based service isn't used instead.
USE_LIVE_ECMWF=false

# RainViewer radar reflectivity — real, quantitative dBZ (not a rendered PNG
# guess), NO API KEY NEEDED. India coverage is itself IMD's public radar
# network, republished by RainViewer rather than pulled from MOSDAC
# directly. Radial (Doppler) velocity has no public equivalent, so the
# downburst hazard rule stays synthetic even with this on — see
# nowcast/ingestion/rainviewer_radar.py.
USE_LIVE_RADAR=false

# Blitzortung.org real lightning strikes — free community VLF network, NO
# API KEY NEEDED. Fills the gap neither the IMD feed nor Tomorrow.io cover
# (Tomorrow.io's realtime endpoint has no lightning field). Independent of
# USE_LIVE_IMD — applies on top of whichever station source is active. Zero
# nearby strikes is a normal real result (no storm right now), not a bug.
# See nowcast/ingestion/blitzortung_lightning.py.
USE_LIVE_LIGHTNING=false
